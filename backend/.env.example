APP_NAME=Axiom
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_FRONTEND_URL=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=production
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Postgres (Neon.tech free tier).
# Grab the connection string from the Neon dashboard and copy the parts.
# Neon requires sslmode=require, so keep PGSSLMODE set.
DB_CONNECTION=pgsql
DB_HOST=ep-your-project.us-east-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=axiom
DB_USERNAME=axiom_owner
DB_PASSWORD=
PGSSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use database driver so we don't need a separate Redis service on the
# free tier. Swap to redis if you provision Upstash or self-host later.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — Resend free tier (3k emails/mo) for reset/verification.
# Create an API key at https://resend.com and use it as MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum — bearer token expiration (minutes) and CORS-allowed SPA origins.
SANCTUM_STATEFUL_DOMAINS=app.example.com
SANCTUM_TOKEN_EXPIRATION=60
SANCTUM_TOKEN_PREFIX=

# Frontend origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=https://app.example.com

# Two-factor challenge token TTL (minutes).
TWO_FACTOR_CHALLENGE_TTL=5

# Sentry (optional; leave blank to disable). traces_sample_rate 0.0-1.0.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

VITE_APP_NAME="${APP_NAME}"
