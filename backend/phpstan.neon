includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes
        - tests

    level: 6

    excludePaths:
        - database/migrations/*_create_cache_table.php
        - database/migrations/*_create_jobs_table.php
        - database/migrations/*_create_permission_tables.php

    checkModelProperties: true

    ignoreErrors:
        # Laravel default UserFactory returns array<string,mixed>; the parent
        # Factory<TModel>::definition() signature uses a more specific type.
        -
            message: '#Return type .+ of method Database\\Factories\\UserFactory::definition\(\) should be compatible with#'
            path: database/factories/UserFactory.php

        # Framework default: config/sanctum.php sprintf uses variadic args as a fallback list.
        -
            message: '#Call to sprintf contains 2 placeholders#'
            path: config/sanctum.php
